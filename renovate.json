{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "tools run with `go run module/cmd/tool@version` in the Woodpecker pipeline",
      "managerFilePatterns": ["/^\\.woodpecker\\.ya?ml$/"],
      "matchStrings": ["go run (?<depName>[a-zA-Z0-9./_-]+?)(?:/cmd/[a-z]+)?@(?<currentValue>v[0-9][^\\s]*)"],
      "datasourceTemplate": "go"
    }
  ]
}
