# Installed by the package (deb, rpm). The service starts only when /etc/hsmgate/hsmgate.yaml exists: run `sudo hsmgate-setup` (or `sudo hsmgate setup`) to make it.
# deploy/hsmgate.service in the repository is the same unit for a hand installation (the program in /usr/local/bin).
[Unit]
Description=hsmgate: a policy-checked door in front of a key token
Documentation=https://github.com/zystem/hsmgate
After=network-online.target pcscd.service
ConditionPathExists=/etc/hsmgate/hsmgate.yaml
Wants=network-online.target
# a card needs the smart card daemon; keys in files do not: it is wanted here, not required (the package only recommends it)
Wants=pcscd.socket

[Service]
Type=simple
ExecStart=/usr/bin/hsmgate serve -config /etc/hsmgate/hsmgate.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
User=hsmgate
Group=hsmgate
# the PIN, if it is kept in a file at all: a file owned by this user, mode 0400, named by pin_file, tried once at start (see docs/operations.md; the other way is
# `hsmgate unlock`). Not LoadCredential=: systemd gives that file to the service through an ACL and it shows as mode 0440, which the service refuses.
RuntimeDirectory=hsmgate
RuntimeDirectoryMode=0750
LogsDirectory=hsmgate
LogsDirectoryMode=0750
ConfigurationDirectory=hsmgate
ConfigurationDirectoryMode=0750

# sandbox: the service talks to pcscd over its unix socket, listens on one port, writes the audit log and nothing else
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# no core dumps: the PIN and shared secrets are in memory
LimitCORE=0

[Install]
WantedBy=multi-user.target
